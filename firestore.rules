rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // মাস্টার এডমিন চেক (ইমেইল ভেরিফিকেশন সহ বা সরাসরি ইমেইল ম্যাচ)
    function isMasterAdmin() {
      return signedIn()
        && request.auth.token.email == 'clkmonir@gmail.com';
    }

    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // অনুমোদিত এডমিন চেক (মাস্টার এডমিন অথবা ডাটাবেজে এপ্রুভড এডমিন)
    function isApprovedAdmin() {
      return isMasterAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
    }

    function canManageTenant() {
      return isApprovedAdmin();
    }

    function isActivePartner(tenantId) {
      return signedIn() && (isMasterAdmin() || (
        exists(/databases/$(database)/documents/businesses/$(tenantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/businesses/$(tenantId)/members/$(request.auth.uid)).data.status == 'active'
      ));
    }

    function matchingSaleLedger(tenantId) {
      let salePath = /databases/$(database)/documents/businesses/$(tenantId)/partner_sales/$(request.resource.data.lastLedgerId);
      return request.resource.data.lastLedgerType == 'partner_sale'
        && !exists(salePath)
        && existsAfter(salePath)
        && getAfter(salePath).data.partnerUid == request.auth.uid
        && request.resource.data.operationalCashBalance
          == resource.data.operationalCashBalance + getAfter(salePath).data.total;
    }

    function matchingExpenseLedger(tenantId) {
      let expensePath = /databases/$(database)/documents/businesses/$(tenantId)/partner_expenses/$(request.resource.data.lastLedgerId);
      return request.resource.data.lastLedgerType == 'partner_expense'
        && !exists(expensePath)
        && existsAfter(expensePath)
        && getAfter(expensePath).data.partnerUid == request.auth.uid
        && request.resource.data.operationalCashBalance
          == resource.data.operationalCashBalance - getAfter(expensePath).data.amount;
    }

    // ইউজার প্রোফাইল কালেকশন
    match /users/{userId} {
      // মাস্টার এডমিন যেকোনো ইউজার পড়তে বা লিস্ট করতে পারবে, অন্যথায় শুধু নিজেরটা পারবে
      allow read: if signedIn() && (request.auth.uid == userId || isMasterAdmin());
      allow list: if isMasterAdmin();

      // নতুন ইউজার একাউন্ট খোলার নিয়ম
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.accountStatus == 'Pending Approval'
        && request.resource.data.role == 'Pending';

      // আপডেট: মাস্টার এডমিন যেকোনো সময় যেকোনো ইউজারের রোল বা স্ট্যাটাস এপ্রুভ করতে পারবে
      allow update: if isMasterAdmin()
        || (signedIn() && request.auth.uid == userId
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
            || (!resource.data.keys().hasAny(['accountStatus'])
              && request.resource.data.accountStatus == 'Pending Approval'
              && request.resource.data.role == 'Pending')));

      allow delete: if isMasterAdmin();

      match /sales/{recordId} {
        allow read, write: if isMasterAdmin() || (request.auth.uid == userId && isApprovedAdmin());
      }

      match /expenses/{recordId} {
        allow read, write: if isMasterAdmin() || (request.auth.uid == userId && isApprovedAdmin());
      }

      match /creditors/{recordId} {
        allow read, write: if isMasterAdmin() || (request.auth.uid == userId && isApprovedAdmin());
      }

      match /cash_register/{recordId} {
        allow read, write: if isMasterAdmin() || (request.auth.uid == userId && isApprovedAdmin());
      }

      match /settings/{settingId} {
        allow read, write: if isMasterAdmin() || (request.auth.uid == userId && isApprovedAdmin());
      }
    }

    // বিজনেস ও পার্টনার কালেকশন
    match /businesses/{tenantId} {
      allow read: if canManageTenant() || isActivePartner(tenantId);
      allow create, delete: if isMasterAdmin();
      allow update: if isMasterAdmin()
        || (isActivePartner(tenantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'operationalCashBalance', 'lastLedgerId', 'lastLedgerType', 'updatedAt'
          ])
          && request.resource.data.operationalCashBalance >= 0
          && (matchingSaleLedger(tenantId) || matchingExpenseLedger(tenantId)));

      match /members/{memberId} {
        allow read, write: if isMasterAdmin();
      }

      match /partner_sales/{saleId} {
        allow read: if canManageTenant()
          || (isActivePartner(tenantId) && resource.data.partnerUid == request.auth.uid);
        allow create: if isActivePartner(tenantId)
          && request.resource.data.partnerUid == request.auth.uid
          && request.resource.data.settled == false;
        allow update, delete: if canManageTenant();
      }

      match /partner_expenses/{expenseId} {
        allow read: if canManageTenant()
          || (isActivePartner(tenantId) && resource.data.partnerUid == request.auth.uid);
        allow create: if isActivePartner(tenantId)
          && request.resource.data.partnerUid == request.auth.uid
          && request.resource.data.settled == false;
        allow update, delete: if canManageTenant();
      }

      match /settlements/{settlementId} {
        allow read: if canManageTenant()
          || (isActivePartner(tenantId) && resource.data.partnerUid == request.auth.uid);
        allow create, update, delete: if canManageTenant();
      }
    }
  }
}