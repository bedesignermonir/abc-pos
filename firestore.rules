rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant isolation: Each merchant's data is strictly partitioned by their authenticated Google UID.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Invoices / Sales
      match /sales/{saleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Expenses
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Creditors / Loans
      match /creditors/{creditorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily Cash Register & Denominations
      match /cash_register/{cashId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Merchant Settings & Business Details
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Catch-all subcollections under the user document
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
